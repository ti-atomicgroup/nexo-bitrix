# Opcional: o Nexo identifica a URL pública na primeira abertura da instância.
# NEXO_APP_URL=http://localhost:3000
NEXO_DATA_DIR=./data
# Opcional: por padrão, o Nexo gera a chave no volume de dados.
# NEXO_ENCRYPTION_KEY=
# NEXO_SETUP_TOKEN= (compatibilidade com instalações anteriores)
# Opcional: segredo aleatório para conectar o chat Onnira à API OpenAPI do Nexo (mínimo 32 caracteres).
NEXO_CHAT_API_KEY=
# O portal Bitrix24 é identificado pelo webhook informado no assistente do Nexo.
# IA opcional: endpoint compatível com OpenAI Chat Completions. Se faltar qualquer valor, o fluxo manual permanece disponível.
NEXO_AI_BASE_URL=
NEXO_AI_MODEL=
NEXO_AI_API_KEY=
PORT=3000
