NEXO_APP_URL=http://localhost:3000
NEXO_DATA_DIR=./data
# Gere valores com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXO_ENCRYPTION_KEY=
NEXO_SETUP_TOKEN=
# Opcional: segredo aleatório para conectar o chat Onnira à API OpenAPI do Nexo (mínimo 32 caracteres).
NEXO_CHAT_API_KEY=
# Endereco HTTPS do portal, sem /rest nem tokens.
BITRIX_PORTAL_URL=
# IA opcional: endpoint compatível com OpenAI Chat Completions. Se faltar qualquer valor, o fluxo manual permanece disponível.
NEXO_AI_BASE_URL=
NEXO_AI_MODEL=
NEXO_AI_API_KEY=
PORT=3000
