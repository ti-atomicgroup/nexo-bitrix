{
  "name": "nexo",
  "version": "2.0.0",
  "private": true,
  "description": "Nexo: onboarding e offboarding de colaboradores integrados ao Bitrix24, hospedado na Onnira Cloud.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "vitest": "3.2.7"
  }
}
